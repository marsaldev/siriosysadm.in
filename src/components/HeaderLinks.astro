---
// Replaces Starlight's SocialIcons, the only slot in the header's right-hand group: the link to
// the features page, then Starlight's own icons (none configured today). Starlight shows the
// same component in the mobile menu's footer, so the link is there on phones too.
import Default from '@astrojs/starlight/components/SocialIcons.astro';
import { featuresUrl } from './features/copy';
import { localeOf } from './home/copy';

const route = Astro.locals.starlightRoute;
const locale = localeOf(route.lang);
const href = featuresUrl(locale);
const label = locale === 'it' ? 'Funzionalità' : 'Features';
const current = route.id === 'features' || route.id === 'it/features';
---

<a class="header-link" href={href} aria-current={current ? 'page' : undefined}>{label}</a>
<Default />

<style>
	.header-link {
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
	}
	.header-link:hover,
	.header-link[aria-current='page'] {
		color: var(--sl-color-white);
	}
	.header-link[aria-current='page'] {
		text-decoration: underline;
		text-decoration-color: var(--sl-color-accent);
		text-decoration-thickness: 2px;
		text-underline-offset: 0.45em;
	}
	.header-link:focus-visible {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: 3px;
	}
</style>
