---
// A screenshot of the panel in both themes, showing the one that matches the site's. Files live in
// src/assets/screenshots as <name>-<light|dark>-<en|it>.png, taken at 1440×900, 2×. The hidden
// one is lazy and display:none, so the browser never downloads it.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	name: string;
	locale: 'en' | 'it';
	alt: string;
	caption?: string;
	sizes: string;
}

const { name, locale, alt, caption, sizes } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/screenshots/*.png', { eager: true });
const pick = (theme: 'light' | 'dark') => {
	const file = files[`../assets/screenshots/${name}-${theme}-${locale}.png`];
	if (!file) throw new Error(`Screenshot missing: ${name}-${theme}-${locale}.png`);
	return file.default;
};
const widths = [720, 1080, 1440, 2160, 2880];
---

<figure class="shot">
	<div class="frame">
		<Image class="dark" src={pick('dark')} {alt} {widths} {sizes} format="webp" quality={82} loading="lazy" />
		<Image class="light" src={pick('light')} {alt} {widths} {sizes} format="webp" quality={82} loading="lazy" />
	</div>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.shot {
		margin: 0;
	}
	.frame {
		overflow: hidden;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.75rem;
		background: var(--sl-color-black);
		box-shadow:
			0 1px 2px rgb(0 0 0 / 0.3),
			0 24px 48px -24px rgb(0 0 0 / 0.6);
	}
	img {
		display: block;
		width: 100%;
		height: auto;
	}
	.light {
		display: none;
	}
	:global(:root[data-theme='light']) .light {
		display: block;
	}
	:global(:root[data-theme='light']) .dark {
		display: none;
	}
	:global(:root[data-theme='light']) .frame {
		border-color: var(--sl-color-gray-5);
		box-shadow:
			0 1px 2px rgb(16 26 51 / 0.06),
			0 24px 48px -28px rgb(16 26 51 / 0.35);
	}
	figcaption {
		margin-top: 0.75rem;
		color: var(--sl-color-gray-3);
		font-size: 0.9rem;
		line-height: 1.5;
	}
</style>
